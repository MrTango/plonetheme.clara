<?xml version="1.0" encoding="UTF-8"?>
<registry>

  <!-- Remove all plone.bundles/plonetheme-clara.* records registered by
       the default profile, so no orphaned bundle keeps loading clara.min.css
       and clara.js after uninstall. -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-clara"
           remove="true" />

  <!-- Clara styles every page itself and therefore switches the theming
       engine off in its default profile. Once Clara is gone nothing paints
       the site: no Diazo theme, no auto-injected `diazo` bundle, so no
       barceloneta.min.css either. Switch plone.app.theming back on — its own
       default — so an uninstalled site falls back to stock Plone chrome
       instead of unstyled HTML. -->
  <record name="plone.app.theming.interfaces.IThemeSettings.enabled">
    <value>True</value>
  </record>

  <!-- The searchbox goes back to the base package's slot. Clara's own
       entries stay behind harmlessly: their elements go with the browser
       layer, and an assignment naming no element renders nothing. -->
  <record name="plone.pageletlayout.slot_assignments">
    <value purge="false">
      <element key="plone.pageletlayout.searchbox">plone.portalheader</element>
    </value>
  </record>

  <record name="plonetheme.clara.search_on_demand" remove="True" />

</registry>
