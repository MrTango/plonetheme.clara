<?xml version="1.0" encoding="UTF-8"?>
<registry>

  <!-- Clara's one compiled bundle (`pnpm run build` from theme/scss/clara.scss),
       Bootstrap included. No `depends` and no expression gate: it styles
       every page, since Diazo is off (below). -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-clara">
    <value key="csscompilation">++resource++plonetheme.clara/clara.min.css</value>
    <!-- clara.js: close gestures for the CSS-only mega menu and search. -->
    <value key="jscompilation">++resource++plonetheme.clara/clara.js</value>
    <value key="load_defer">True</value>
    <!-- explicitly empty: an import never clears omitted keys -->
    <value key="expression"></value>
    <value key="enabled">True</value>
  </records>

  <!-- No Diazo: Clara styles every page, so barceloneta.min.css goes. -->
  <record name="plone.app.theming.interfaces.IThemeSettings.enabled">
    <value>False</value>
  </record>

  <!-- The mega menu panels need the sections' children. -->
  <record field="navigation_depth"
          interface="plone.base.interfaces.INavigationSchema"
          prefix="plone">
    <value>3</value>
  </record>

  <!-- Where Clara's elements render; purge="false" keeps the base's others.
       Navigation, language switch and search share plone.mainnavigation. -->
  <record name="plone.pageletlayout.slot_assignments">
    <value purge="false">
      <element key="plonetheme.clara.languageselector">plone.mainnavigation</element>
      <element key="plone.pageletlayout.searchbox">plone.mainnavigation</element>
      <element key="plonetheme.clara.subnav">plone.belowcontentbody</element>
    </value>
  </record>

  <!-- Opt-in: the header shows only a search toggle, the form opens on demand. -->
  <record name="plonetheme.clara.search_on_demand">
    <field type="plone.registry.field.Bool">
      <title>Search opens on demand</title>
      <description>Show a search toggle in the header instead of an always-open search field.</description>
      <required>False</required>
    </field>
    <value>False</value>
  </record>

</registry>
