<?xml version="1.0" encoding="UTF-8"?>
<object>
  <!-- The sub-navigation joins the whole-body layout manager's order directly
       after the content body, so it renders below the page and above the
       footer rows.

       insert-after, not a restated order: plone.pageletlayout owns the
       canonical sequence (layout.ELEMENTS, pinned by its own parity test) and
       this file must not fork it. The importer starts from whatever order is
       stored, removes the name if present and re-inserts it at the anchor —
       so this is additive, idempotent, and survives the base package growing
       new elements. -->
  <order manager="plone.pageletlayout.layout" skinname="Plone Default">
    <viewlet name="plonetheme.clara.subnav"
             insert-after="plone.pageletlayout.body" />
    <!-- The language switch opens the header's utility lane: after the
         navigation, before the search. -->
    <viewlet name="plonetheme.clara.languageselector"
             insert-after="plone.pageletlayout.globalnav" />
  </order>

  <!-- The stock selector Clara's own element replaces.

       plone.app.multilingual registers its selector into plone.portalheader,
       and plone.pageletlayout bridges that manager into the layout — so the
       stock switch renders on every page of a multilingual site, one row
       under the header, beside the element that exists to replace it. Which
       is the same trade the base package makes for the logo, the breadcrumbs
       and the byline: bridge the manager, hide what we reimplement.

       Configuration, not a code-level exemption: an integrator who prefers
       plone.app.multilingual's markup unhides this and hides
       plonetheme.clara.languageselector instead. -->
  <hidden manager="plone.portalheader" skinname="Plone Default">
    <viewlet name="plone.app.multilingual.languageselector" />
  </hidden>
</object>
