<?xml version="1.0" encoding="UTF-8"?>
<object>
  <!-- Each element's place inside the stock manager registry.xml assigns it
       to. insert-after / insert-before, not a restated order: Plone and
       plone.pageletlayout own each manager's sequence, and this file only
       anchors Clara's names into it — additive and idempotent. -->
  <order manager="plone.mainnavigation" skinname="Plone Default">
    <viewlet name="plonetheme.clara.languageselector"
             insert-after="plone.pageletlayout.globalnav" />
    <viewlet name="plone.pageletlayout.searchbox"
             insert-after="plonetheme.clara.languageselector" />
  </order>
  <order manager="plone.belowcontentbody" skinname="Plone Default">
    <viewlet name="plonetheme.clara.subnav" insert-before="*" />
  </order>
</object>
