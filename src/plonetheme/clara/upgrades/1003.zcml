<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.clara">

  <genericsetup:upgradeSteps
      source="1002"
      destination="1003"
      profile="plonetheme.clara:default">

    <genericsetup:upgradeStep
        title="Clara styles everything: disable Diazo, ungate the bundle"
        description="Reimport registry.xml (drops the X-Theme-Disabled bundle
                     gate, sets plone.app.theming enabled=False) and move the
                     events aggregator off the classic-only event_listing view."
        handler=".v1003.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
