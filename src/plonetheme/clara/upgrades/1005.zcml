<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.clara">

  <genericsetup:upgradeSteps
      source="1004"
      destination="1005"
      profile="plonetheme.clara:default">

    <genericsetup:upgradeStep
        title="Sub-navigation chrome pagelet"
        description="Register plonetheme.clara.subnav in the whole-body layout manager, directly after plone.pageletlayout.body."
        handler=".v1005.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
