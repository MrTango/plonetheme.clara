<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.clara">

  <genericsetup:registerProfile
      name="1008"
      title="plonetheme.clara: upgrade to 1008"
      directory="1008"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1007"
      destination="1008"
      profile="plonetheme.clara:default">

    <!-- plone.pageletlayout 1004 replaced the whole-body manager with the
         stock managers; Clara's three elements get their slot and their
         place in it. Narrowed to the two import steps the profile carries. -->
    <genericsetup:upgradeDepends
        title="Assign Clara&#39;s elements to the stock viewlet managers"
        description="Language switch and searchbox into plone.mainnavigation, the sub-navigation into plone.belowcontentbody."
        import_profile="plonetheme.clara.upgrades:1008"
        import_steps="plone.app.registry viewlets"
        />

  </genericsetup:upgradeSteps>

</configure>
