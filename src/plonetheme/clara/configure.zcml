<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonetheme.clara">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <!-- The mega-panel globalnav, replacing the base's on Clara's layer. -->
  <include package="plone.pageletlayout" file="meta.zcml" />
  <plone:chromepagelet
      name="plone.pageletlayout.globalnav"
      class=".pagelets.ClaraGlobalnavChromePagelet"
      layer=".interfaces.IPlonethemeClaraLayer"
      />

  <!-- The page-tail sub-navigation: a new element, so the chrome pagelet
       plus its PageletViewlet (registry.xml and viewlets.xml place it). -->
  <plone:chromepagelet
      name="plonetheme.clara.subnav"
      class=".pagelets.SubnavChromePagelet"
      template="templates/subnav.pt"
      layer=".interfaces.IPlonethemeClaraLayer"
      />
  <browser:viewlet
      name="plonetheme.clara.subnav"
      pagelet="plonetheme.clara.subnav"
      class="plone.pageletlayout.pagelets.layout.PageletViewlet"
      manager="plone.pageletlayout.pagelets.slots.ILayoutManager"
      layer=".interfaces.IPlonethemeClaraLayer"
      permission="zope2.View"
      />

  <!-- The header language switch, a new element like the sub-navigation.
       It replaces plone.app.multilingual's selector (hidden in viewlets.xml). -->
  <plone:chromepagelet
      name="plonetheme.clara.languageselector"
      class=".pagelets.LanguageSelectorChromePagelet"
      template="templates/languageselector.pt"
      layer=".interfaces.IPlonethemeClaraLayer"
      />
  <browser:viewlet
      name="plonetheme.clara.languageselector"
      pagelet="plonetheme.clara.languageselector"
      class="plone.pageletlayout.pagelets.layout.PageletViewlet"
      manager="plone.pageletlayout.pagelets.slots.ILayoutManager"
      layer=".interfaces.IPlonethemeClaraLayer"
      permission="zope2.View"
      />

  <!-- Static files: the compiled bundle, clara.js, fonts, images. -->
  <browser:resourceDirectory
      name="plonetheme.clara"
      directory="static"
      />

  <genericsetup:registerProfile
      name="default"
      title="Plonetheme Clara"
      description="A Plone theme based on plone.pageletlayout"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Plonetheme Clara (uninstall)"
      description="Uninstalls plonetheme.clara"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- Hide the uninstall and upgrade profiles from the Add-ons panel. -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="plonetheme.clara-hiddenprofiles"
      />

  <include package=".upgrades" />

  <include package=".behaviors" />

</configure>
