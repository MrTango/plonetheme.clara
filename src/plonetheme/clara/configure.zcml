<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonetheme.clara">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <!-- Clara's mega-panel globalnav: same provider name as the base
       registration, on Clara's (more specific) layer. The subclass
       inherits the base's globalnav.pt shell template. -->
  <include package="plone.pageletlayout" file="meta.zcml" />
  <plone:chromepagelet
      name="plone.pageletlayout.globalnav"
      class=".pagelets.ClaraGlobalnavChromePagelet"
      layer=".interfaces.IPlonethemeClaraLayer"
      />

  <!-- Clara's page-tail sub-navigation: a NEW layout element, so it needs
       both halves — the chrome pagelet (the element) and the PageletViewlet
       wrapper that registers it for the element pool. registry.xml assigns
       it to plone.belowcontentbody, viewlets.xml gives it the first place
       there.

       It belongs here rather than in a brand theme because wayfinding into a
       folder's children is generic: any Clara-based site with a default page
       over children wants it, and a brand layer only re-points its tokens. -->
  <plone:chromepagelet
      name="plonetheme.clara.subnav"
      class=".pagelets.SubnavChromePagelet"
      template="templates/subnav.pt"
      layer=".interfaces.IPlonethemeClaraLayer"
      />
  <browser:viewlet
      name="plonetheme.clara.subnav"
      pagelet="plonetheme.clara.subnav"
      class="plone.pageletlayout.pagelets.layout.PageletViewlet"
      manager="plone.pageletlayout.pagelets.layout.ILayoutManager"
      layer=".interfaces.IPlonethemeClaraLayer"
      permission="zope2.View"
      />

  <!-- Clara's language switch: like the sub-navigation, a NEW layout
       element — the chrome pagelet and the PageletViewlet wrapper.
       registry.xml assigns it to plone.mainnavigation, viewlets.xml places
       it after the global navigation: the header's utility lane reads
       navigation, language switch, search.

       plone.app.multilingual's own selector (plone.portalheader) is hidden
       in viewlets.xml; this element replaces it with Clara's markup. -->
  <plone:chromepagelet
      name="plonetheme.clara.languageselector"
      class=".pagelets.LanguageSelectorChromePagelet"
      template="templates/languageselector.pt"
      layer=".interfaces.IPlonethemeClaraLayer"
      />
  <browser:viewlet
      name="plonetheme.clara.languageselector"
      pagelet="plonetheme.clara.languageselector"
      class="plone.pageletlayout.pagelets.layout.PageletViewlet"
      manager="plone.pageletlayout.pagelets.layout.ILayoutManager"
      layer=".interfaces.IPlonethemeClaraLayer"
      permission="zope2.View"
      />

  <!-- Clara's brand token file, served at ++resource++plonetheme.clara/ and
       linked via a registry bundle (profiles/default/registry.xml). -->
  <browser:resourceDirectory
      name="plonetheme.clara"
      directory="static"
      />

  <genericsetup:registerProfile
      name="default"
      title="Plonetheme Clara"
      description="A Plone theme based on plone.pageletlayout"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Plonetheme Clara (uninstall)"
      description="Uninstalls plonetheme.clara"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- Hide the uninstall + upgrade profiles from the Add-ons panel; the
       upgrade profiles are applied by their upgrade steps, never installed
       by hand. -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="plonetheme.clara-hiddenprofiles"
      />


  <include package=".upgrades" />


  <include package=".behaviors" />

</configure>
